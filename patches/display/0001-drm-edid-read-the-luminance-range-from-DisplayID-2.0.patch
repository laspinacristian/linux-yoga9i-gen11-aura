From 9dabbfc3d0d88b4fc8e234a4e9f597560f7da80e Mon Sep 17 00:00:00 2001
From: Cristian La Spina <cristian.laspina@kernel.srl>
Date: Mon, 27 Jul 2026 03:10:00 +0200
Subject: [PATCH 1/2] drm/edid: read the luminance range from DisplayID 2.0

Panels carrying CTA HDR static metadata get their luminance range
computed into display_info.luminance_range by
drm_calculate_luminance_range(). Panels publishing the same information
through the DisplayID 2.0 Display Parameters Data Block get nothing: the
DisplayID parsing in the core only looks at timings.

Such panels exist. The OLED panel in the Lenovo Yoga 9 2-in-1 14IPH11
(EDO EE00QBA63.E) carries two DisplayID 2.0 extension blocks and no CTA
extension at all, and declares in its Display Parameters block:

  Native Maximum Luminance (Full Coverage): 500.000 cd/m^2
  Native Minimum Luminance:                   4.000 cd/m^2

Parse that block and fill in the luminance range from it when the EDID
has not already provided one, so drivers doing nits based backlight
control have a real range to work with instead of a hardcoded guess.

CTA HDR static metadata keeps precedence, so panels providing both go on
behaving exactly as before.

DisplayID 2.0 encodes luminance as IEEE 754 binary16, an encoding the
core has not needed until now; add a small decoder for it.

Assisted-by: Claude:claude-opus-5
Signed-off-by: Cristian La Spina <cristian.laspina@kernel.srl>
---
 drivers/gpu/drm/drm_displayid_internal.h | 16 +++++
 drivers/gpu/drm/drm_edid.c               | 79 ++++++++++++++++++++++++
 include/drm/drm_connector.h              |  3 +-
 3 files changed, 97 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/drm_displayid_internal.h b/drivers/gpu/drm/drm_displayid_internal.h
index 5b1b32f..b34db07 100644
--- a/drivers/gpu/drm/drm_displayid_internal.h
+++ b/drivers/gpu/drm/drm_displayid_internal.h
@@ -142,6 +142,22 @@ struct displayid_formula_timing_block {
 	struct displayid_formula_timings_9 timings[];
 } __packed;
 
+/* DisplayID 2.0 Display Parameters Data Block, luminance in binary16 nits */
+struct displayid_display_parameters_block {
+	struct displayid_block base;
+	__le16 horizontal_image_size;
+	__le16 vertical_image_size;
+	__le16 horizontal_pixel_count;
+	__le16 vertical_pixel_count;
+	u8 feature_support;
+	u8 color_point[12];
+	__le16 native_max_luminance_full_coverage;
+	__le16 native_max_luminance_1_percent;
+	__le16 native_min_luminance;
+	u8 native_color_depth;
+	u8 gamma_eotf;
+} __packed;
+
 #define DISPLAYID_VESA_MSO_OVERLAP	GENMASK(3, 0)
 #define DISPLAYID_VESA_MSO_MODE		GENMASK(6, 5)
 
diff --git a/drivers/gpu/drm/drm_edid.c b/drivers/gpu/drm/drm_edid.c
index df3c25b..fc5920b 100644
--- a/drivers/gpu/drm/drm_edid.c
+++ b/drivers/gpu/drm/drm_edid.c
@@ -6672,6 +6672,84 @@ static void drm_update_mso(struct drm_connector *connector,
 	displayid_iter_end(&iter);
 }
 
+/*
+ * Convert an IEEE 754 binary16 value, the encoding DisplayID 2.0 uses for
+ * luminance, to nits rounded to nearest. Negative, zero, subnormal, infinite
+ * and NaN all report 0, meaning "no usable value".
+ */
+static u32 displayid_binary16_to_nits(u16 val)
+{
+	int exp = (val >> 10) & 0x1f;
+	u32 mant = (val & 0x3ff) | 0x400;
+	int shift;
+
+	if (val & 0x8000 || exp == 0 || exp == 0x1f)
+		return 0;
+
+	shift = exp - 25;
+	if (shift >= 0)
+		return shift > 15 ? 0 : mant << shift;
+
+	shift = -shift;
+	if (shift > 11)
+		return 0;
+
+	return (mant + (1 << (shift - 1))) >> shift;
+}
+
+static void drm_parse_displayid_luminance(struct drm_connector *connector,
+					  const struct displayid_block *block)
+{
+	const struct displayid_display_parameters_block *params =
+		(const struct displayid_display_parameters_block *)block;
+	struct drm_display_info *info = &connector->display_info;
+	u32 max, min;
+
+	if (block->num_bytes + sizeof(*block) <
+	    offsetofend(struct displayid_display_parameters_block,
+			native_min_luminance)) {
+		drm_dbg_kms(connector->dev,
+			    "[CONNECTOR:%d:%s] Unexpected Display Parameters block size %u\n",
+			    connector->base.id, connector->name, block->num_bytes);
+		return;
+	}
+
+	max = displayid_binary16_to_nits(le16_to_cpu(params->native_max_luminance_full_coverage));
+	min = displayid_binary16_to_nits(le16_to_cpu(params->native_min_luminance));
+
+	if (!max || min >= max)
+		return;
+
+	info->luminance_range.max_luminance = max;
+	info->luminance_range.min_luminance = min;
+
+	drm_dbg_kms(connector->dev,
+		    "[CONNECTOR:%d:%s] DisplayID luminance range %u-%u nits\n",
+		    connector->base.id, connector->name, min, max);
+}
+
+static void drm_update_displayid_luminance(struct drm_connector *connector,
+					   const struct drm_edid *drm_edid)
+{
+	const struct displayid_block *block;
+	struct displayid_iter iter;
+
+	/*
+	 * CTA HDR static metadata takes precedence: drm_parse_cea_ext() has
+	 * run already, and panels providing both keep the range they had.
+	 */
+	if (connector->display_info.luminance_range.max_luminance)
+		return;
+
+	displayid_iter_edid_begin(drm_edid, &iter);
+	displayid_iter_for_each(block, &iter) {
+		if (displayid_version(&iter) == DISPLAY_ID_STRUCTURE_VER_20 &&
+		    block->tag == DATA_BLOCK_2_DISPLAY_PARAMETERS)
+			drm_parse_displayid_luminance(connector, block);
+	}
+	displayid_iter_end(&iter);
+}
+
 /* A connector has no EDID information, so we've got no EDID to compute quirks from. Reset
  * all of the values which would have been set from EDID
  */
@@ -6774,6 +6852,7 @@ static void update_display_info(struct drm_connector *connector,
 	drm_parse_cea_ext(connector, drm_edid);
 
 	update_displayid_info(connector, drm_edid);
+	drm_update_displayid_luminance(connector, drm_edid);
 
 	/*
 	 * Digital sink with "DFP 1.x compliant TMDS" according to EDID 1.3?
diff --git a/include/drm/drm_connector.h b/include/drm/drm_connector.h
index f83f28c..4d48552 100644
--- a/include/drm/drm_connector.h
+++ b/include/drm/drm_connector.h
@@ -425,7 +425,8 @@ struct drm_monitor_range_info {
  * &drm_display_info. Calculated using data in EDID
  *
  * This struct is used to store a luminance range supported by panel
- * as calculated using data from EDID's static hdr metadata.
+ * as calculated using data from EDID's static hdr metadata, or as read
+ * from the DisplayID 2.0 Display Parameters Data Block.
  *
  * @min_luminance: This is the min supported luminance value
  *
-- 
